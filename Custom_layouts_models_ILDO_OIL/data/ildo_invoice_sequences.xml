<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_ildo_customer_invoice" model="ir.sequence">
            <field name="name">ILDO OIL - Factures clients (FA)</field>
            <field name="code">ildo_oil.customer_invoice</field>
            <field name="implementation">no_gap</field>
            <field name="prefix">FA%(y)s</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <record id="seq_ildo_customer_credit" model="ir.sequence">
            <field name="name">ILDO OIL - Avoirs clients (FV)</field>
            <field name="code">ildo_oil.customer_credit</field>
            <field name="implementation">no_gap</field>
            <field name="prefix">FV%(y)s</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <record id="seq_ildo_customer_invoice_2026" model="ir.sequence.date_range">
            <field name="sequence_id" ref="seq_ildo_customer_invoice"/>
            <field name="date_from">2026-01-01</field>
            <field name="date_to">2026-12-31</field>
            <field name="number_next">1400</field>
        </record>

        <record id="seq_ildo_customer_credit_2026" model="ir.sequence.date_range">
            <field name="sequence_id" ref="seq_ildo_customer_credit"/>
            <field name="date_from">2026-01-01</field>
            <field name="date_to">2026-12-31</field>
            <field name="number_next">1101</field>
        </record>
    </data>
</odoo>
