<?xml version="1.0" encoding="utf-8"?>
<odoo auto_sequence="1">

    <!--
        TEST ILDO OIL
        Balance des tiers utilisant le moteur
        natif du Livre des tiers Odoo Enterprise.

        Aucun calcul comptable personnalise.
        Rapport original conserve.
    -->

    <record id="ildo_third_party_balance_native_test_report"
            model="account.report">

        <field name="name">
            Balance des tiers
        </field>

        <field name="root_report_id" eval="False"/>

        <field name="filter_show_draft" eval="True"/>
        <field name="filter_account_type">both</field>
        <field name="filter_partner" eval="True"/>
        <field name="filter_journals" eval="True"/>

        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_unreconciled" eval="True"/>
        <field name="filter_period_comparison" eval="False"/>

        <field name="filter_multi_company">selector</field>
        <field name="filter_hide_0_lines">never</field>

        <field name="default_opening_date_filter">this_year</field>
        <field name="search_bar" eval="True"/>
        <field name="load_more_limit" eval="80"/>

        <!-- MOTEUR NATIF DU LIVRE DES TIERS -->
        <field name="custom_handler_model_id"
               ref="account_reports.model_account_partner_ledger_report_handler"/>

        <!-- TROIS COLONNES UNIQUEMENT -->
        <field name="column_ids">

            <record id="ildo_native_test_debit"
                    model="account.report.column">
                <field name="name">Débit</field>
                <field name="expression_label">debit</field>
                <field name="figure_type">monetary</field>
                <field name="sequence">10</field>
            </record>

            <record id="ildo_native_test_credit"
                    model="account.report.column">
                <field name="name">Crédit</field>
                <field name="expression_label">credit</field>
                <field name="figure_type">monetary</field>
                <field name="sequence">20</field>
            </record>

            <record id="ildo_native_test_balance"
                    model="account.report.column">
                <field name="name">Solde</field>
                <field name="expression_label">balance</field>
                <field name="figure_type">monetary</field>
                <field name="sequence">30</field>
            </record>

        </field>

    </record>

    <!-- ACTION DE TEST INDEPENDANTE -->

    <record id="action_ildo_third_party_balance_native_test"
            model="ir.actions.client">

        <field name="name">Balance des tiers</field>
        <field name="tag">account_report</field>
        <field name="path">third-party-balance-native-test</field>

        <field name="context"
               eval="{'report_id': ref('ildo_third_party_balance_native_test_report')}"/>

    </record>

    <!-- MENU TEMPORAIRE -->

    <menuitem
        id="menu_ildo_third_party_balance_native_test"
        name="Balance des tiers"
        parent="account.account_reports_partners_reports_menu"
        action="action_ildo_third_party_balance_native_test"
        sequence="31"
        groups="account.group_account_invoice,account.group_account_readonly"/>


    <!-- ILDO_BALANCE_FINALISATION_NATIVE_20261120 -->

    <!--
        L'ancien rapport est conserve pour
        permettre un retour arriere.
    -->

    <record id="ildo_third_party_balance_report"
            model="account.report">

        <field name="name">
            Balance des tiers (ARCHIVE - ancien calcul)
        </field>

    </record>

    <!--
        Le menu historique reste actif.
        Son action ouvre maintenant
        le nouveau rapport natif.
    -->

    <record id="action_ildo_third_party_balance"
            model="ir.actions.client">

        <field name="name">Balance des tiers</field>

        <field name="context"
               eval="{'report_id': ref('ildo_third_party_balance_native_test_report')}"/>

    </record>

    <!--
        Desactiver le menu provisoire.
        Evite deux menus Balance des tiers.
    -->

    <record id="menu_ildo_third_party_balance_native_test"
            model="ir.ui.menu">

        <field name="active" eval="False"/>

    </record>

</odoo>
