<?xml version="1.0"?>
<odoo>
    <!-- Template QWeb pour la liste groupée des factures -->
    <template id="invoice_list_report">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
            <t t-set="is_invoice_list" t-value="True"/>
                <div class="page">
                    <h2>
                        <strong>Liste des factures sélectionnées</strong>
                    </h2>
                    <p>
                        <em>Nombre de factures : <t t-esc="len(docs)"/>
                        </em>
                    </p>
                    <t t-set="total_amount" t-value="0"/>
                    <t t-foreach="docs" t-as="inv">
                        <t t-set="total_amount" t-value="total_amount + inv.amount_total"/>
                    </t>
                    <table class="table table-bordered" style="width:100%;font-size:14px;">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Numéro</th>
                                <th>Client</th>
                                <th>Échéance</th>
                                <th>Montant</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="inv">
                                <td>
                                    <span t-field="inv.invoice_date"/>
                                </td>
                                <td>
                                    <span t-field="inv.name"/>
                                </td>
                                <td>
                                    <span t-field="inv.partner_id.name"/>
                                </td>
                                <td>
                                    <span t-field="inv.invoice_date_due"/>
                                </td>
                                <td>
                                    <span t-field="inv.amount_total" t-options="{'widget': 'monetary', 'display_currency': inv.currency_id}"/>
                                </td>
                                <td>
                                    <span t-field="inv.state"/>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <t t-if="docs">
                                <tr>
                                    <td colspan="4" style="text-align:right;">
                                        <strong>Montant total :</strong>
                                    </td>
                                    <td colspan="2">
                                        <span t-esc="total_amount"/>
                                        <span t-field="docs[0].currency_id"/>
                                    </td>
                                </tr>
                            </t>
                        </tfoot>
                    </table>
                    <t t-call="Custom_layouts_models_ILDO_OIL.list_print_metadata"/>
                </div>
            </t>
        </t>
    </template>

    <!-- Déclaration du rapport -->
    <report id="invoice_list_report" model="account.move" string="Liste des factures" report_type="qweb-pdf" name="Custom_layouts_models_ILDO_OIL.invoice_list_report" file="Custom_layouts_models_ILDO_OIL.invoice_list_report" />
</odoo>
