<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- Template QWeb pour la liste groupée des commandes d'achat -->
    <template id="purchase_list_report">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="is_purchaseorder_list" t-value="True"/>
                <div class="page">
                    <h2>
                        <strong>Liste des commandes d'achat sélectionnées</strong>
                    </h2>
                    <p>
                        <em>Nombre de commandes : <t t-esc="len(docs)"/></em>
                    </p>
                    <t t-set="total_amount" t-value="0"/>
                    <t t-foreach="docs" t-as="po">
                        <t t-set="total_amount" t-value="total_amount + po.amount_total"/>
                    </t>
                    <table class="table table-bordered" style="width:100%;font-size:14px;">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Numéro</th>
                                <th>Fournisseur</th>
                                <th>Référence</th>
                                <th>Montant</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="po">
                                <td><span t-field="po.date_order" t-options="{'widget': 'date'}"/></td>
                                <td><span t-field="po.name"/></td>
                                <td><span t-field="po.partner_id.name"/></td>
                                <td><span t-field="po.partner_ref"/></td>
                                <td><span t-field="po.amount_total" t-options="{'widget': 'monetary', 'display_currency': po.currency_id}"/></td>
                                <td><span t-field="po.state"/></td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <t t-if="docs">
                                <tr>
                                    <td colspan="4" style="text-align:right;"><strong>Montant total :</strong></td>
                                    <td colspan="2">
                                        <span t-esc="total_amount"/> <span t-field="docs[0].currency_id"/>
                                    </td>
                                </tr>
                            </t>
                        </tfoot>
                    </table>
                    <t t-call="Custom_layouts_models_ILDO_OIL.list_print_metadata"/>
                </div>
            </t>
        </t>
    </template>

    <!-- Déclaration du rapport -->
    <record id="action_purchase_list_report" model="ir.actions.report"><field name="name">Liste des commandes d'achat</field><field name="model">purchase.order</field><field name="report_type">qweb-pdf</field><field name="report_name">Custom_layouts_models_ILDO_OIL.purchase_list_report</field><field name="report_file">Custom_layouts_models_ILDO_OIL.purchase_list_report</field><field name="binding_model_id" ref="purchase.model_purchase_order"/></record></odoo>