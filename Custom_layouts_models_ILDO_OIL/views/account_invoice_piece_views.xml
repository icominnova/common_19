<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_out_invoice_tree_inherit_ildo_piece" model="ir.ui.view">
        <field name="name">account.move.out.invoice.list.ildo.piece</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="ildo_invoice_piece_number"
                       string="Numéro de pièce"
                       optional="show"
                       readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_inherit_ildo_piece" model="ir.ui.view">
        <field name="name">account.move.form.ildo.invoice.piece</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']/field[@name='invoice_date'][1]" position="after">
                <field name="ildo_invoice_piece_number"
                       string="Numéro de pièce"
                       invisible="move_type != 'out_invoice'"
                       readonly="1"
                       placeholder="Attribué automatiquement à la comptabilisation"/>
            </xpath>
        </field>
    </record>
</odoo>
