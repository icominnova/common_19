<?xml version="1.0"?>
<odoo>
    <!-- Template QWeb pour la liste groupée des réceptions/expéditions -->
    <template id="stock_list_report">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="is_stock_list" t-value="True"/>
                <div class="page">
                    <h2>
                        <strong>Liste des opérations de stock sélectionnées</strong>
                    </h2>
                    <p>
                        <em>Nombre d'opérations : <t t-esc="len(docs)"/>
                        </em>
                    </p>
                    <table class="table table-bordered" style="width:100%;font-size:14px;">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Référence</th>
                                <th>Contact</th>
                                <th>Document</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="pick">
                                <td>
                                    <span t-field="pick.scheduled_date" t-options="{'widget': 'date'}"/>
                                </td>
                                <td>
                                    <span t-field="pick.name"/>
                                </td>
                                <td>
                                    <span t-field="pick.partner_id.name"/>
                                </td>
                                <td>
                                    <span t-field="pick.origin"/>
                                </td>
                                <td>
                                    <span t-field="pick.state"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <t t-call="Custom_layouts_models_ILDO_OIL.list_print_metadata"/>
                </div>
            </t>
        </t>
    </template>

    <!-- Déclaration du rapport -->
    <report id="stock_list_report" model="stock.picking" string="Liste des opérations de stock" report_type="qweb-pdf" name="Custom_layouts_models_ILDO_OIL.stock_list_report" file="Custom_layouts_models_ILDO_OIL.stock_list_report" />
</odoo>
