<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Colonne dans Comptabilité > Fournisseurs > Factures -->
    <record id="view_in_invoice_tree_inherit_ildo_piece" model="ir.ui.view">
        <field name="name">account.move.in.invoice.list.ildo.piece</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="ildo_vendor_piece_number"
                       string="Numéro de pièce"
                       optional="show"
                       readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Numéro de pièce sur la fiche facture fournisseur -->
    <record id="view_move_form_inherit_ildo_vendor_piece" model="ir.ui.view">
        <field name="name">account.move.form.ildo.vendor.piece</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']/field[@name='invoice_date'][2]" position="after">
                <field name="ildo_vendor_piece_number"
                       string="Numéro de pièce"
                       invisible="move_type != 'in_invoice'"
                       readonly="1"
                       placeholder="Attribué automatiquement à la comptabilisation"/>
            </xpath>
        </field>
    </record>
</odoo>
