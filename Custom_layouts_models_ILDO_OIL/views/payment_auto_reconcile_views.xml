<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_payment_auto_reconcile_wizard_form" model="ir.ui.view">
        <field name="name">ildo.payment.auto.reconcile.wizard.form</field>
        <field name="model">ildo.payment.auto.reconcile.wizard</field>
        <field name="arch" type="xml">
            <form string="Réconciliation automatique des paiements">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <div class="w-100">
                    <field name="preview_html" nolabel="1" readonly="1"/>
                </div>
                <footer>
                    <button name="action_simulate"
                            string="Simuler"
                            type="object"
                            class="btn-primary"/>
                    <button string="Fermer"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_payment_auto_reconcile_wizard" model="ir.actions.act_window">
        <field name="name">Réconcilier les paiements</field>
        <field name="res_model">ildo.payment.auto.reconcile.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_payment_auto_reconcile_wizard_form"/>
        <field name="target">new</field>
    </record>

    <record id="view_account_payment_list_auto_reconcile" model="ir.ui.view">
        <field name="name">account.payment.list.ildo.auto.reconcile</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/header" position="inside">
                <button name="%(action_payment_auto_reconcile_wizard)d"
                        string="Réconcilier"
                        type="action"
                        display="always"
                        class="btn-primary"/>
            </xpath>
        </field>
    </record>
</odoo>
