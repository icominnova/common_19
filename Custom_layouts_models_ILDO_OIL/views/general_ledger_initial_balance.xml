<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record
        id="ildo_gl_initial_balance_expression"
        model="account.report.expression">

        <field
            name="report_line_id"
            ref="account_reports.general_ledger_custom_engine_line"/>

        <field name="label">ildo_initial_balance</field>

        <field name="engine">custom</field>

        <field name="formula">_report_custom_engine_general_ledger</field>

        <field name="subformula">ildo_initial_balance</field>

        <field name="date_scope">strict_range</field>

    </record>

    <record
        id="ildo_gl_initial_balance_column"
        model="account.report.column">

        <field
            name="report_id"
            ref="account_reports.general_ledger_report"/>

        <field name="name">Solde initial</field>

        <field name="sequence">45</field>

        <field name="expression_label">ildo_initial_balance</field>

        <field name="figure_type">monetary</field>

    </record>

</odoo>
