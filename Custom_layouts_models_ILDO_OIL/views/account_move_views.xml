<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_move_form_inherit_ildo_invoice_number" model="ir.ui.view">
        <field name="name">account.move.form.inherit.ildo.invoice.number</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_reverse']" position="attributes">
                <attribute name="invisible" add="move_type == 'out_invoice'" separator=" or "/>
            </xpath>
            <xpath expr="//header/button[@name='action_reverse']" position="after">
                <button name="action_ildo_create_credit_note"
                        string="Créer un avoir"
                        type="object"
                        groups="account.group_account_invoice"
                        invisible="move_type != 'out_invoice' or state != 'posted'"
                        data-hotkey="shift+n"/>
            </xpath>
            <xpath expr="//group[@id='header_right_group']/field[@name='invoice_date'][1]" position="after">
                <field name="ildo_invoice_number"
                       invisible="move_type not in ('out_invoice', 'out_refund')"
                       readonly="state != 'draft'"
                       placeholder="Laisser vide pour la numérotation automatique"/>
            </xpath>
            <xpath expr="//group[@id='header_right_group']/field[@name='invoice_date'][2]" position="after">
                <field name="ildo_vendor_invoice_number"
                       invisible="move_type not in ('in_invoice', 'in_refund')"
                       readonly="state != 'draft'"
                       placeholder="Laisser vide pour la numérotation automatique"/>
            </xpath>
        </field>
    </record>
</odoo>
