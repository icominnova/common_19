<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_ildo_customer_sales_stats_wizard" model="ir.ui.view">
        <field name="name">ildo.customer.sales.stats.wizard.form</field>
        <field name="model">ildo.customer.sales.stats.wizard</field>
        <field name="arch" type="xml">
            <form string="Statistiques clients">
                <group string="Période des ventes" col="2">
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="company_id"
                           groups="base.group_multi_company"/>
                </group>

                <footer>
                    <button name="action_print_report"
                            string="Imprimer le PDF"
                            type="object"
                            class="btn-primary"/>
                    <button string="Annuler"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ildo_customer_sales_stats_wizard"
            model="ir.actions.act_window">
        <field name="name">Statistiques clients</field>
        <field name="res_model">ildo.customer.sales.stats.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_account_invoice_ildo_sales_stats_button"
            model="ir.ui.view">
        <field name="name">account.invoice.ildo.sales.stats.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//list/header" position="inside">
                <button name="%(action_ildo_customer_sales_stats_wizard)d"
                        type="action"
                        string="Statistiques clients"
                        class="btn-secondary"
                        display="always"
                        groups="account.group_account_invoice"/>
            </xpath>

        </field>
    </record>

</odoo>
