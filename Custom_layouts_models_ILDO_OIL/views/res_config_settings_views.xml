<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_ildo_be_bl" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ildo.be.bl</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']" position="inside">
                <setting id="ildo_show_be_bl_numbers"
                         string="Numéros historiques BE et BL"
                         help="Afficher les champs N° BE et N° BL sur les devis et les transferts. Les valeurs enregistrées sont conservées lorsque l'option est désactivée."
                         company_dependent="1">
                    <field name="ildo_show_be_bl_numbers"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
