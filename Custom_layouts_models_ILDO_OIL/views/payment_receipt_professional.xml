<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_payment_receipt_professional_document">
        <t t-call="web.external_layout">
            <div class="page o_ildo_receipt_page">
                <style>
                    .o_ildo_receipt_page {
                        font-family: Arial, Helvetica, sans-serif;
                        color: #000;
                        font-size: 12px;
                    }
                    .o_ildo_receipt_title {
                        color: #000;
                        font-size: 18px;
                        font-weight: 700;
                        text-align: left;
                        margin: 18px 0 20px;
                        text-transform: uppercase;
                    }
                    .o_ildo_receipt_table { width: 100%; border-collapse: collapse; }
                    .o_ildo_receipt_table th {
                        background: #fff;
                        color: #000;
                        border: 1px solid #000;
                        padding: 6px 8px;
                        font-size: 11px;
                    }
                    .o_ildo_receipt_table td {
                        border: 1px solid #000;
                        padding: 8px;
                    }
                    .o_ildo_receipt_amount { text-align: right; white-space: nowrap; }
                    .o_ildo_receipt_total {
                        margin-top: 18px;
                        background: #fff;
                        padding: 0;
                        color: #000;
                        font-weight: 700;
                    }
                    .o_ildo_receipt_signatures { margin-top: 65px; }
                    .o_ildo_receipt_signature_title {
                        color: #000;
                        font-weight: 700;
                        text-transform: uppercase;
                    }
                </style>

                <div class="o_ildo_receipt_title">
                    Reçu de règlement N° <span t-field="o.name"/>
                </div>

                <table class="o_ildo_receipt_table">
                    <thead>
                        <tr>
                            <th style="width: 18%;">Date</th>
                            <th style="width: 57%;">Libellé</th>
                            <th class="o_ildo_receipt_amount" style="width: 25%;">Montant</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><span t-field="o.date" t-options="{'widget': 'date'}"/></td>
                            <td>
                                <span t-out="o.memo or o.payment_method_line_id.name or o.name"/>
                            </td>
                            <td class="o_ildo_receipt_amount">
                                <span t-field="o.amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <div class="o_ildo_receipt_total">
                    Montant total réglé :
                    <span t-out="o.ildo_amount_to_text()"/>
                </div>

                <div class="row o_ildo_receipt_signatures text-center">
                    <div class="col-5">
                        <div class="o_ildo_receipt_signature_title">La caisse</div>
                    </div>
                    <div class="col-5 offset-2">
                        <div class="o_ildo_receipt_signature_title">
                            <span t-esc="'Le client' if o.partner_type == 'customer' else 'Le fournisseur'"/>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_payment_receipt_professional">
        <t t-foreach="docs" t-as="o">
            <t t-set="lang" t-value="o.partner_id.lang or 'fr_FR'"/>
            <t t-call="Custom_layouts_models_ILDO_OIL.report_payment_receipt_professional_document" t-lang="lang"/>
        </t>
    </template>

    <record id="account.action_report_payment_receipt" model="ir.actions.report">
        <field name="name">Reçu de règlement</field>
        <field name="report_name">Custom_layouts_models_ILDO_OIL.report_payment_receipt_professional</field>
        <field name="report_file">Custom_layouts_models_ILDO_OIL.report_payment_receipt_professional</field>
        <field name="paperformat_id" ref="Custom_layouts_models_ILDO_OIL.paperformat_no_header"/>
        <field name="print_report_name">'Reçu de règlement - %s' % (object.name)</field>
    </record>
</odoo>
