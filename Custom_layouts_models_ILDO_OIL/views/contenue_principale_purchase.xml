<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="contenue_principal_purchase" inherit_id="purchase.report_purchaseorder_document">
                
            <xpath expr="//table[.//t[@t-foreach='o.order_line.filtered(lambda l: l.display_type or l.product_qty != 0)']]" position="replace">
               
                <t t-if="o and o._name == 'purchase.order'">
                    <t t-set="year" t-value="str(o.date_order.year)[-2:] if o.date_order else ''"/>
                    <t t-set="seq" t-value="o.name.split('/')[-1].replace('P','') if o.name and '/' in o.name else o.name.replace('P','')"/>
                    <h2 style="font-size: 24px; color: #222; margin-bottom: 12px;">
                        BON D'ENLEVEMENT N° BE<t t-out="year + seq"/>
                    </h2>
                </t>

                <style>
                    .custom-purchase-table {
                        width: 100%;
                        border-collapse: collapse;
                        font-size: 13px;
                        font-family: Arial, Helvetica, sans-serif;
                        border: 2.5px solid #222;
                        margin-top: 0 !important;
                    }
                    .custom-purchase-table th, .custom-purchase-table td {
                        border: 2.5px solid #222 !important;
                        padding: 2px 5px;
                        text-align: center;
                        vertical-align: top;
                        line-height: 1.05;
                    }
                    .custom-purchase-table th {
                        font-weight: bold;
                        font-size: 13px;
                    }
                    .custom-purchase-table thead {
                        display: table-header-group;
                    }
                    .custom-purchase-table tbody tr {
                        page-break-inside: avoid !important;
                        break-inside: avoid-page !important;
                    }
                    .custom-purchase-table .desc-cell, .custom-purchase-table th.desc-cell {
                        text-align: left !important;
                        word-break: break-word;
                        overflow-wrap: break-word;
                        white-space: normal;
                        max-width: 320px;
                    }
                    .custom-purchase-table td {
                        background: transparent !important;
                    }
                    .custom-purchase-table tbody td:first-child {
                        white-space: nowrap;
                        word-break: keep-all;
                        overflow-wrap: normal;
                        font-size: 12px;
                    }
                    /* Corps du tableau : uniquement les bordures verticales, sans lignes horizontales entre produits. */
                    .custom-purchase-table tbody td {
                        border-top: 0 !important;
                        border-bottom: 0 !important;
                        border-left: 2.5px solid #222 !important;
                        border-right: 2.5px solid #222 !important;
                    }
                    .custom-purchase-table tbody tr:last-child td {
                        border-bottom: 2.5px solid #222 !important;
                    }
                </style>
                <table class="custom-purchase-table" style="border:2.5px solid #222; width: 100%; table-layout: fixed;">
                    <thead>
                        <tr>
                            <th rowspan="2">Référence</th>
                            <th rowspan="2" class="desc-cell">Désignation</th>
                            <th colspan="2">Quantité (Litres)</th>
                        </tr>
                        <tr>
                            <th>En chiffre</th>
                            <th>En lettre</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="o.order_line" t-as="line">
                            <tr>
                                <td>
                                    <span t-field="line.product_id.default_code"/>
                                </td>
                                <td class="desc-cell">
                                    <span t-if="line.product_id" t-field="line.product_id.name"/>
                                    <span t-else="" t-field="line.name"/>
                                </td>
                                <td>
                                    <span t-field="line.product_qty"/>
                                </td>
                                <td class="col-en-lettre">
                                    <span t-esc="line.qty_to_words()"/>
                                </td>
                            </tr>

                        </t>
                    </tbody>
                </table>
            </xpath>
        </template>
    </data>
</odoo>
