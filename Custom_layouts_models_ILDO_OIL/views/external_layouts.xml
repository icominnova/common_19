<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="ildo_footer_image">
        <div style="width:100%; margin-top:4px; text-align:center; clear:both;">
            <img src="/Custom_layouts_models_ILDO_OIL/static/src/img/footer_clean_v2.png"
                 style="width:100%; height:10mm; object-fit:fill; display:block; margin:0; border:0;"
                 alt="Pied de page ILDO OIL"/>
        </div>
    </template>

    <template id="external_layouts">
        <t t-call="web.report_layout">
            <style>
                .ildo-summary-area,
                .ildo-summary-area table,
                .ildo-summary-area thead,
                .ildo-summary-area tbody,
                .ildo-summary-area tr,
                .ildo-summary-area th,
                .ildo-summary-area td {
                    background: #fff !important;
                    background-color: #fff !important;
                    --bs-table-bg: #fff;
                    --bs-table-accent-bg: #fff;
                    --bs-table-striped-bg: #fff;
                }
            </style>
            <!-- Initialisation de la hauteur de la forme d'entête (utilisée pour le style) -->
            <t t-set="header_shape_height" t-value="'0'"/>

            <!-- Corps principal du rapport -->
            <div t-attf-class="article o_report_layout_wave o_company_#{company.id}_layout">

                <!-- Bloc d'entête du document -->
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <!-- Affichage du logo de la société si présent -->
                    <t t-if="company.logo">
                        <img t-if="company.logo" class="o_company_logo_big mb-2" t-att-src="image_data_uri(company.logo)" alt="Logo"/>
                    </t>
                    <!-- Affichage du slogan ou header de la société si présent -->
                    <t t-if="company.report_header">
                        <div t-field="company.report_header" class="o_company_tagline mw-50 fw-bold">Company tagline</div>
                    </t>
                </div>
                <t t-if="not is_payment_list and not is_invoice_list and not is_saleorder_list and not is_purchaseorder_list and not is_stock_list">
                    <div class="row" style="padding:0px; background:transparent; max-width:700px; width:80%; margin:0px auto -20px 0px; font-size:12px;">
                        <ul class="list-unstyled" name="company_address_list">
                            <!-- Bloc 1 : Affichage de l'adresse de la société si les détails sont vides -->
                            <li t-if="company.is_company_details_empty">
                                <span t-field="company.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'>
                                    <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 w-100 opacity-75 text-muted text-center">
                                        <strong>Company address block</strong>
                                        <div>Contains the company address.</div>
                                    </div>
                                </span>
                            </li>
                            <!-- Bloc 2 : Affichage des détails de la société si disponibles -->
                            <li t-else="">
                                <span t-field="company.company_details">
                                    <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 w-100 opacity-75 text-muted text-center">
                                        <strong>Company details block</strong>
                                        <div>Contains the company details.</div>
                                    </div>
                                </span>
                            </li>
                            <!-- Bloc 3 : Affichage du numéro de TVA si non forcé -->
                            <li t-if="not forced_vat">
                                <t t-if="company.vat">
                                    <t t-esc="company.country_id.vat_label or 'Tax ID'">Tax ID</t>:
                                    <span t-esc="company.vat">US12345671</span>
                                </t>
                            </li>
                            <!-- Bloc 4 : Affichage du numéro de TVA forcé -->
                            <li t-else="">
                                <t t-esc="company.country_id.vat_label or 'Tax ID'">Tax ID</t>:
                                <span t-esc="forced_vat">US12345671</span>
                            </li>
                        </ul>
                    </div>
                    <!-- Section d'information client et détails de la commande -->
                    <div class="d-flex flex-row align-items-start" style="width:100%;">
                        <!-- Bloc BC Client à gauche -->
                        <t t-if="o and o._name != 'stock.picking'">
                            <div style="border:2.5px solid #222; border-radius:8px; padding:8px 16px; margin:10px 0 10px 0; max-width:340px; min-width:180px; width:40%; height:130px; position:relative;">
                                <div style="position:absolute; top:10px; left:15px; font-weight:bold;">BC Client</div>
                                <!-- Date en haut à droite -->
                                <div style="position:absolute; top:10px; right:10px; font-weight:bold; text-align:center; width:90px;">
                                    <span style="display:block; font-size:15px;" class="date-label">Date</span>
                                    <span>
                                        <t t-if="o and o._name == 'sale.order'">
                                            <span t-field="o.date_order" t-options="{'widget': 'date'}"/>
                                        </t>
                                        <t t-elif="o and o._name == 'account.move'">
                                            <span t-field="o.invoice_date"/>
                                        </t>
                                        <t t-elif="o and o._name == 'account.payment'">
                                            <span t-field="o.date"/>
                                        </t>
                                        <t t-elif="o and o._name == 'purchase.order'">
                                            <span t-field="o.date_order" t-options="{'widget': 'date'}"/>
                                        </t>
                                    </span>
                                </div>
                                <!-- Référence en bas à gauche -->
                                <div style="position:absolute; bottom:10px; left:15px; right:15px; font-weight:bold; text-align:left; overflow-wrap:anywhere;">
                                    <span style="display:block;" class="ref-label">Référence</span>
                                    <span>
                                        <t t-if="o and o._name == 'sale.order'">
                                            <span t-field="o.client_order_ref"/>
                                        </t>
                                        <t t-elif="o and o._name == 'account.move'">
                                            <t t-set="year" t-value="str(o.invoice_date.year)[-2:] if o.invoice_date else ''"/>
                                            <t t-set="seq" t-value="o.name.split('/')[-1] if o.name and '/' in o.name else o.name"/>
                                            <t t-set="seq" t-value="str(seq or '').zfill(3)"/>
                                            <span t-out="'BE' + year + seq"/>
                                        </t>
                                        <t t-elif="o and o._name == 'account.payment'">
                                            <span t-field="o.name"/>
                                        </t>
                                        <t t-elif="o and o._name == 'purchase.order'">
                                            <span t-field="o.partner_ref"/>
                                        </t>
                                    </span>
                                </div>
                            </div>
                        </t>
                        <!-- Bloc pour les bons d'enlèvement/livraison -->
                        <t t-if="o and o._name == 'stock.picking'">
                            <div style="border:2.5px solid #222; border-radius:8px; padding:8px 16px; margin:10px 0 10px 0; max-width:340px; min-width:180px; width:40%; height:130px; position:relative;">
                                <!-- Référence en haut à gauche -->
                                <div style="position:absolute; top:10px; left:10px; font-weight:bold;">
                                    <span>Référence</span>
                                    <br/>
                                    <t t-set="year" t-value="str(o.scheduled_date.year)[-2:] if o.scheduled_date else ''"/>
                                    <t t-set="seq" t-value="o.name.split('/')[-1] if o.name and '/' in o.name else o.name"/>
                                    <t t-set="seq" t-value="str(seq or '').zfill(3)"/>
                                    <span t-out="o.ildo_be_number or ('BE' + year + seq)"/>
                                </div>
                                <!-- Date en haut à droite -->
                                <div style="position:absolute; top:10px; right:10px; font-weight:bold; text-align:center; width:90px;">
                                    <span style="display:block; font-size:15px;">Date</span>
                                    <span t-field="o.scheduled_date" t-options="{'widget': 'date'}"/>
                                </div>
                                <!-- Destination en bas à gauche -->
                                <div style="position:absolute; bottom:10px; left:10px; font-weight:bold;">
                                    <span>Destination</span>
                                    <br/>
                                    <span t-out="o.sale_id.ildo_destination or o.partner_id.city"/>
                                </div>
                            </div>
                        </t>

                        <t t-set="client_partner" t-value="False"/>
                        <t t-if="o and o._name in ['account.move', 'account.payment', 'purchase.order']"
                           t-set="client_partner"
                           t-value="o.partner_id"/>
                        <t t-if="o and o._name == 'stock.picking'"
                           t-set="client_partner"
                           t-value="o.partner_id"/>
                        <t t-if="doc and doc._name == 'sale.order'"
                           t-set="client_partner"
                           t-value="doc.partner_id"/>

                        <!-- Adresse de la société (appel du template standard, encadrée) -->
                        <div style="border:2.5px solid #222; border-radius:8px; padding:8px 16px; margin-left:180px; max-width:340px; min-width:180px; width:40%; display:block;">
                            <div style="display: flex; flex-direction: column; gap: 6px; font-weight:bold; font-size:15px;">
                                <div style="display: flex; flex-direction: row; justify-content:space-between;">
                                    <span>Code client :</span>
                                    <span>
                                        <t t-if="client_partner">
                                            <t t-set="client_initials"
                                               t-value="''.join([(part[:1] or '').upper() for part in (client_partner.name or '').split()])"/>
                                            <span t-out="client_partner.code_client or ('C%s%s' % (client_initials, client_partner.id))"/>
                                        </t>
                                    </span>
                                </div>
                                <div style="display: flex; flex-direction: row; justify-content:space-between;">
                                    <span>Client :</span>
                                    <span t-if="client_partner" t-field="client_partner.name"/>
                                </div>
                                <div style="display: flex; flex-direction: row; justify-content:space-between;">
                                    <span>Téléphone :</span>
                                    <span t-if="client_partner" t-field="client_partner.phone"/>
                                </div>
                                <div style="display: flex; flex-direction: row; justify-content:space-between;">
                                    <span>Adresse :</span>
                                    <span t-if="client_partner" t-field="client_partner.street"/>
                                </div>
                                <div style="display: flex; flex-direction: row; justify-content:space-between;">
                                    <span>Ville :</span>
                                    <span t-if="client_partner" t-field="client_partner.city"/>
                                </div>
                                <div style="display: flex; flex-direction: row; justify-content:space-between;">
                                    <span>Rue :</span>
                                    <span t-if="client_partner" t-field="client_partner.street2"/>
                                </div>
                                <div style="display: flex; flex-direction: row; justify-content:space-between;">
                                    <span>RCCM :</span>
                                    <span t-if="client_partner" t-out="client_partner.rccm"/>
                                </div>
                                <div style="display: flex; flex-direction: row; justify-content:space-between;">
                                    <span>N° IFU :</span>
                                    <span t-if="client_partner" t-out="client_partner.ifu"/>
                                </div>
                                <div style="display: flex; flex-direction: row; justify-content:space-between;">
                                    <span>Division F :</span>
                                    <span t-if="client_partner" t-out="client_partner.division_f"/>
                                </div>
                                <div style="display: flex; flex-direction: row; justify-content:space-between;">
                                    <span>Régime I :</span>
                                    <span t-if="client_partner" t-out="client_partner.regime_i"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
                <!-- Titre du document (dynamique selon le contexte) -->
                <t t-if="o and o._name == 'account.move'">
                    <t t-set="year" t-value="str(o.invoice_date.year)[-2:] if o.invoice_date else ''"/>
                    <t t-set="seq" t-value="o.name.split('/')[-1] if o.name and '/' in o.name else o.name"/>
                    <t t-set="seq" t-value="str(seq or '').zfill(4)"/>
                    <!-- pour forcer 4 chiffres -->
                    <h2 style="font-size: 24px;">
                        FACTURE N° <t t-out="o.ildo_invoice_number or o.ildo_vendor_invoice_number or ('FA' + year + seq)"/>
                    </h2>
                </t>
                <t t-if="doc and doc._name == 'sale.order'">
                    <t t-set="year" t-value="str(doc.date_order.year)[-2:] if doc.date_order else ''"/>
                    <t t-set="seq" t-value="doc.name.lstrip('S').zfill(5) if doc.name.startswith('S') else doc.name"/>
                    <h2 style="font-size: 24px; color: #b8860b;">
                        COMMANDE N° S<t t-out="year + seq"/>
                    </h2>
                </t>


                <!-- Insertion du contenu principal du rapport (lignes, tableaux, etc.) -->
                <t t-out="0"/>

                <!-- Exemple de tableau de taxes (à adapter selon les besoins) -->
                <t t-if="o and o._name == 'account.move'">
                    <table class="ildo-summary-area" style="width: 100%; border: 1.5px solid transparent; border-collapse: collapse; margin-top: 18px; background:#fff !important;">
                        <tr style="width: 100%; border: 1.5px solid transparent; border-collapse: collapse;">
                            <td style="vertical-align: top; width: 40%;">
                                <!-- Tableau Code/Base/Taux/Montant -->
                                <table style="width: 100%; font-size: 13px; border-collapse: collapse; border: 2.5px solid #222;">
                                    <thead>
                                        <tr style="border-bottom: 2.5px solid #222;text-align: center;">
                                            <th style="font-weight: bold;">Code</th>
                                            <th style="font-weight: bold;">Base</th>
                                            <th style="font-weight: bold;">Taux</th>
                                            <th style="font-weight: bold;">Montant</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="o.tax_totals['subtotals']" t-as="subtotal">
                                            <tr t-foreach="subtotal['tax_groups']" t-as="tax_group" style="border-bottom: 2.5px solid #222;text-align: center;">
                                                <td><span t-out="tax_group['group_name']"/></td>
                                                <td>
                                                    <span t-out="tax_group['base_amount_currency']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                                </td>
                                                <td><span t-out="tax_group['group_label'] or '-'"/></td>
                                                <td>
                                                    <span t-out="tax_group['tax_amount_currency']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <tr style="border-bottom: 2.5px solid #222;text-align: center;">
                                            <td style="font-weight: bold;">TOTAL</td>
                                            <td><span t-field="o.amount_untaxed" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                            <td/>
                                            <td><span t-field="o.amount_tax" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                            <td style="vertical-align: top; text-align: center; width: 20%;">
                                <!-- Date échéance -->
                                <div style="border: 1.5px solid transparent; padding: 0 16px; display: inline-block; margin-top: 0;">
                                    <div style="font-weight: bold; font-size: 14px;white-space: nowrap;">Date échéance</div>
                                    <div style="font-size: 15px; margin-bottom: 10px;">
                                        <span t-field="o.invoice_date_due"/>
                                    </div>
                                </div>
                            </td>
                            <td style="vertical-align: top; width: 40%;">
                                <!-- Tableau Total HT/TTC/Net -->
                                <table style="width: 100%; font-size: 13px; border-collapse: collapse; border: 2.5px solid #222; margin-top: 0;">
                                    <thead>
                                        <tr style="border-bottom: 2.5px solid #222;">
                                            <th style="font-weight: bold; border-bottom: 2.5px solid #222; border-right: 2.5px solid #222; text-align: center;">Total HT</th>
                                            <th style="font-weight: bold; border-bottom: 2.5px solid #222; border-right: 2.5px solid #222; text-align: center;">Total TTC</th>
                                            <th style="font-weight: bold; border-bottom: 2.5px solid #222; text-align: center;">NET A PAYER</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td style="border-right: 2.5px solid #222; text-align: center; white-space: nowrap;">
                                                <span t-field="o.amount_untaxed" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                            </td>
                                            <td style="border-right: 2.5px solid #222; text-align: center; white-space: nowrap;">
                                                <span t-field="o.amount_total" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                            </td>
                                            <td style="text-align: center; white-space: nowrap;">
                                                <span t-field="o.amount_total" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <!-- Montant total de la facture en lettres -->
                    <div style="margin-top: 22px; font-size: 15px; width: 100%; clear: both;">
                        <span>Arrêtée la présente facture à la somme de : </span>
                        <strong>
                            <span t-esc="o.currency_id.with_context(lang='fr_FR').amount_to_text(o.amount_total)"/>
                        </strong>
                    </div>

                    <!-- Section Conditions de vente -->
                    <div style="margin-top: 8px; font-size: 15px; width: 100%;">
                        <span style="font-weight: bold; text-decoration: underline;">Conditions de vente</span>
                        <br/>
                        <span>.Frais de recouvrement à la charge du client</span>
                    </div>
                </t>

                <t t-if="o and  o._name == 'sale.order'">
                    <table class="ildo-summary-area" style="width: 100%; border: 1.5px solid transparent; border-collapse: collapse; margin-top: 18px; background:#fff !important;">
                        <tr style="width: 100%; border: 1.5px solid transparent; border-collapse: collapse;">
                            <td style="vertical-align: top; width: 40%;">
                                <!-- Tableau Code/Base/Taux/Montant -->
                                <table style="width: 100%; font-size: 13px; border-collapse: collapse; border: 2.5px solid #222;">
                                    <thead>
                                        <tr style="border-bottom: 2.5px solid #222;text-align: center;">
                                            <th style="font-weight: bold;">Code</th>
                                            <th style="font-weight: bold;">Base</th>
                                            <th style="font-weight: bold;">Taux</th>
                                            <th style="font-weight: bold;">Montant</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="o.tax_totals['subtotals']" t-as="subtotal">
                                            <tr t-foreach="subtotal['tax_groups']" t-as="tax_group" style="border-bottom: 2.5px solid #222;text-align: center;">
                                                <td><span t-out="tax_group['group_name']"/></td>
                                                <td>
                                                    <span t-out="tax_group['base_amount_currency']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                                </td>
                                                <td><span t-out="tax_group['group_label'] or '-'"/></td>
                                                <td>
                                                    <span t-out="tax_group['tax_amount_currency']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <tr style="border-bottom: 2.5px solid #222;text-align: center;">
                                            <td style="font-weight: bold;">TOTAL</td>
                                            <td><span t-field="o.amount_untaxed" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                            <td/>
                                            <td><span t-field="o.amount_tax" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                            <td style="vertical-align: top; text-align: center; width: 20%;">
                                <!-- Date échéance -->
                                <div style="border: 1.5px solid transparent; padding: 0 16px; display: inline-block; margin-top: 0;">
                                    <div style="font-weight: bold; font-size: 14px;white-space: nowrap;">Date échéance</div>
                                    <div style="font-size: 15px; margin-bottom: 10px;">
                                        <span t-field="o.validity_date"/>
                                    </div>
                                </div>
                            </td>
                            <td style="vertical-align: top; width: 40%;">
                                <!-- Tableau Total HT/TTC/Net -->
                                <table style="width: 100%; font-size: 13px; border-collapse: collapse; border: 2.5px solid #222; margin-top: 0;">
                                    <thead>
                                        <tr style="border-bottom: 2.5px solid #222;">
                                            <th style="font-weight: bold; border-bottom: 2.5px solid #222; border-right: 2.5px solid #222; text-align: center;">Total HT</th>
                                            <th style="font-weight: bold; border-bottom: 2.5px solid #222; border-right: 2.5px solid #222; text-align: center;">Total TTC</th>
                                            <th style="font-weight: bold; border-bottom: 2.5px solid #222; text-align: center;">NET A PAYER</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td style="border-right: 2.5px solid #222; text-align: center; white-space: nowrap;">
                                                <span t-field="o.amount_untaxed" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                            </td>
                                            <td style="border-right: 2.5px solid #222; text-align: center; white-space: nowrap;">
                                                <span t-field="o.amount_total" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                            </td>
                                            <td style="text-align: center; white-space: nowrap;">
                                                <span t-field="o.amount_total" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    </table>
                    <!-- Section montant en lettres, collée au tableau -->
                    <div style="margin-top: 22px; font-size: 15px; width: 100%; clear: both;">
                        <span>Arrêtée la présente facture à la somme de : </span>
                        <strong>
                            <span t-esc="o.currency_id.with_context(lang='fr_FR').amount_to_text(o.amount_total)"/>
                        </strong>
                    </div>

                    <!-- Section Conditions de vente -->
                    <div style="margin-top: 8px; font-size: 15px; width: 100%;">
                        <span style="font-weight: bold; text-decoration: underline;">Conditions de vente</span>
                        <br/>
                        <span>.Frais de recouvrement à la charge du client</span>
                    </div>
                </t>

                <!-- Section Observations ou réserves à la réception -->


                <t t-if="o and (o._name == 'purchase.order' or o._name == 'stock.picking')">
                    <div style="margin-top:14px;">
                        <strong>Observations ou réserves à la réception</strong>
                        <div style="border-top:2px dashed #222; border-bottom:2px dashed #222; height:28px; margin-top:5px; margin-bottom:5px;"/>
                        <div style="width:100%; display:flex; flex-direction:row; justify-content:space-between; margin-top:18px;">
                            <div style="font-weight:bold; text-align:left;">VISA CLIENT</div>
                            <div style="font-weight:bold; text-align:right; margin-right:100px;">VISA ILDO OIL</div>
                        </div>
                    </div>
                </t>

                <t t-if="o and (o._name == 'purchase.order' or o._name == 'stock.picking')">
                    <div style="margin-top:30px; font-size:13px;">
                        <span style="font-weight:bold;">NB :</span>
                        Aucune contestation ou réclamation ne sera admise après que le bordereau de livraison ait été signé par le client.
                    </div>
                </t>

            </div>

            <!-- Pied de page du rapport -->
            <div t-attf-class="footer o_company_#{company.id}_layout {{report_type != 'pdf' and 'mt-auto'}}" style="font-size:10px;">
                <div class="o_footer_content pt-1" style="width:100%;">
                    <div>
                        <div class="text-start" t-field="company.report_footer"/>
                        <t t-call="Custom_layouts_models_ILDO_OIL.ildo_footer_image"/>
                    </div>
                    <div class="text-end text-muted">
                        <!-- Affichage du nom du document dans le pied de page (PDF uniquement) -->
                        <div t-if="report_type == 'pdf' and display_name_in_footer" t-out="o.name">(document name)</div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
