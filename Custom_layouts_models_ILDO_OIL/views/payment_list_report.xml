<?xml version="1.0"?>
<odoo>
    <!-- Template QWeb pour la liste des paiements (test) -->
    <template id="payment_list_report">
        <t t-call="web.html_container">
            <t t-set="docs" t-value="env['account.payment'].browse(payment_ids or doc_ids).exists()"/>
            <t t-call="web.external_layout">
                <t t-set="is_payment_list" t-value="True"/>
                <div class="page">
                    <h2>
                        <strong>Liste des paiements</strong>
                    </h2>
                    <p>
                        <em>Nombre de paiements : <t t-esc="len(docs)"/>
                        </em>
                    </p>
                    <div style="margin-bottom:12px;">
                        <strong>Période :</strong>
                        <span t-esc="period_label"/>
                        <span style="margin-left:24px;"><strong>Journal :</strong></span>
                        <span t-esc="journal_label"/>
                    </div>
                    <t t-set="total_amount" t-value="0"/>
                    <t t-foreach="docs" t-as="o">
                        <t t-set="total_amount" t-value="total_amount + o.amount"/>
                    </t>
                    <table class="table table-bordered" style="width:100%;font-size:14px;">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Numéro</th>
                                <th>Journal</th>
                                <th>Mode de paiement</th>
                                <th>Client</th>
                                <th>Montant</th>
                                <th>État</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="o">
                                <td>
                                    <span t-field="o.date"/>
                                </td>
                                <td>
                                    <span t-field="o.name"/>
                                </td>
                                <td>
                                    <span t-field="o.journal_id.name"/>
                                </td>
                                <td>
                                    <span t-field="o.payment_method_id.name"/>
                                </td>
                                <td>
                                    <span t-field="o.partner_id.name"/>
                                </td>
                                <td>
                                    <span t-field="o.amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </td>
                                <td>
                                    <span t-field="o.state"/>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <t t-if="docs">
                                <tr>
                                    <td colspan="5" style="text-align:right;">
                                        <strong>Montant total :</strong>
                                    </td>
                                    <td colspan="2">
                                        <span t-esc="total_amount"/>
                                        <span t-field="docs[0].currency_id"/>
                                    </td>
                                </tr>
                            </t>
                        </tfoot>
                    </table>
                    <t t-call="Custom_layouts_models_ILDO_OIL.list_print_metadata"/>
                </div>
            </t>
        </t>
    </template>
</odoo>
