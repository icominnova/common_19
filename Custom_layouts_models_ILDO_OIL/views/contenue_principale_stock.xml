<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="contenu_principal_delivery" inherit_id="stock.report_delivery_document">
            <!-- Neutraliser le bloc fautif du template principal -->
            <xpath expr="//div[@name='div_outgoing_address']" position="replace">
                <div name="div_outgoing_address"/>
            </xpath>
            <!-- Masquer le premier titre du rapport de livraison -->
            <xpath expr="//h2[span[@t-out]]" position="replace">
                <!-- Titre masqué -->
            </xpath>
            <!-- Masquer les blocs standards déjà repris dans le cartouche et le tableau ILDO. -->
            <xpath expr="//div[@id='informations']" position="replace">
                <div id="informations" style="display:none;"/>
            </xpath>
            <xpath expr="//table[@name='stock_move_table']" position="replace"/>
            <xpath expr="//table[@name='stock_move_line_table']" position="replace"/>
            <!-- Remplacement du tableau principal -->
            <xpath expr="//div[hasclass('page')]" position="inside">
                <t t-if="o and o._name == 'stock.picking'">
                    <t t-set="year" t-value="str(o.scheduled_date.year)[-2:] if o.scheduled_date else ''"/>
                    <t t-set="seq" t-value="o.name.split('/')[-1] if o.name and '/' in o.name else o.name"/>
                    <h2 style="font-size: 24px; color: #222; margin-bottom: 12px;">
                        BORDEREAU DE LIVRAISON N° <t t-out="o.ildo_bl_number or ('BL' + year + seq)"/>
                    </h2>
                </t>
                <style>
                    .custom-delivery-table {
                        width: 100%;
                        border-collapse: collapse;
                        font-size: 13px;
                        font-family: Arial, Helvetica, sans-serif;
                        border: 2.5px solid #222;
                        margin-top: 0 !important;
                    }
                    .custom-delivery-table th, .custom-delivery-table td {
                        border: 2.5px solid #222 !important;
                        padding: 2px 5px;
                        text-align: center;
                        vertical-align: top;
                        line-height: 1.05;
                        background: transparent !important;
                    }
                    .custom-delivery-table th {
                        font-weight: bold;
                        font-size: 13px;
                    }
                    .custom-delivery-table thead {
                        display: table-header-group;
                    }
                    .custom-delivery-table tbody tr {
                        page-break-inside: avoid !important;
                        break-inside: avoid-page !important;
                        border-top: 0 !important;
                        border-bottom: 0 !important;
                        box-shadow: none !important;
                    }
                    .custom-delivery-table .desc-cell, .custom-delivery-table th.desc-cell {
                        text-align: left !important;
                        word-break: break-word;
                        overflow-wrap: break-word;
                        white-space: normal;
                        max-width: 320px;
                    }
                    .custom-delivery-table td {
                        background: transparent !important;
                    }
                    .custom-delivery-table tbody td:first-child {
                        white-space: nowrap;
                        word-break: keep-all;
                        overflow-wrap: normal;
                        font-size: 12px;
                    }
                    /* Corps du tableau : uniquement les bordures verticales, sans lignes horizontales entre produits. */
                    .custom-delivery-table tbody td {
                        border-top: 0 !important;
                        border-bottom: 0 !important;
                        border-left: 2.5px solid #222 !important;
                        border-right: 2.5px solid #222 !important;
                        box-shadow: none !important;
                        background-image: none !important;
                    }
                    .custom-delivery-table tbody tr:not(:last-child) td {
                        border-bottom-color: transparent !important;
                    }
                    .custom-delivery-table tbody tr:last-child td {
                        border-bottom: 2.5px solid #222 !important;
                    }
                    .custom-delivery-table tbody tr + tr td {
                        border-top-color: transparent !important;
                    }
                    .custom-delivery-table .product-fill-row td {
                        height: 245px;
                    }
                </style>
                <table class="custom-delivery-table" style="border:2.5px solid #222; width: 100%; table-layout: fixed;">
                    <thead>
                        <tr>
                            <th rowspan="2">Référence</th>
                            <th rowspan="2" class="desc-cell">Désignation</th>
                            <th colspan="2">Quantité (Litres)</th>
                        </tr>
                        <tr>
                            <th>En chiffre</th>
                            <th>En lettre</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="o.move_ids.filtered(lambda x: x.product_uom_qty)" t-as="move">
                            <tr>
                                <td>
                                    <span t-field="move.product_id.default_code"/>
                                </td>
                                <td class="desc-cell">
                                    <span t-field="move.product_id.name"/>
                                </td>
                                <td>
                                    <span t-field="move.product_uom_qty"/>
                                </td>
                                <td class="col-en-lettre">
                                    <span t-esc="move.qty_to_words()"/>
                                </td>
                            </tr>
                        </t>
                        <t t-if="not o.move_ids.filtered(lambda x: x.product_uom_qty)">
                            <tr>
                                <td colspan="4">Aucune ligne de produit à afficher.</td>
                            </tr>
                        </t>
                        <tr class="product-fill-row">
                            <td>&#160;</td>
                            <td class="desc-cell">&#160;</td>
                            <td>&#160;</td>
                            <td>&#160;</td>
                        </tr>
                    </tbody>
                </table>
            </xpath>
        </template>
    </data>
</odoo>
