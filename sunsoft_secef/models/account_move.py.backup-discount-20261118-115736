    @api.depends(
        "secef_sale_type",
        "move_type",
        "reversed_entry_id",
        "reversed_entry_id.secef_sale_type",
    )
    def _compute_secef_effective_sale_type(
        self,
    ):
        for move in self:
            if (
                move.move_type == "out_refund"
                and move.reversed_entry_id
            ):
                move.secef_effective_sale_type = (
                    move.reversed_entry_id.secef_sale_type
                    or "local"
                )
            else:
                move.secef_effective_sale_type = (
                    move.secef_sale_type
                    or "local"
                )

    @api.model_create_multi
    def create(
        self,
        vals_list,
    ):
        prepared_vals = []

        for vals in vals_list:
            values = dict(vals)

            move_type = (
                values.get("move_type")
                or self.env.context.get(
                    "default_move_type"
                )
            )

            partner_id = values.get(
                "partner_id"
            )

            if (
                "secef_psvb_group"
                not in values
                and move_type == "out_invoice"
                and partner_id
            ):
                partner = self.env[
                    "res.partner"
                ].browse(
                    partner_id
                )

                values[
                    "secef_psvb_group"
                ] = (
                    partner.secef_psvb_group
                    or False
                )

            prepared_vals.append(
                values
            )

        return super().create(
            prepared_vals
        )

    @api.onchange("partner_id")
    def _onchange_secef_psvb_partner(
        self,
    ):
        for move in self:
            if (
                move.move_type
                == "out_invoice"
                and move.secef_state
                in (
                    "not_certified",
                    "failed",
                )
            ):
                move.secef_psvb_group = (
                    move.partner_id.secef_psvb_group
                    or False
                )

            elif (
                move.move_type
                == "out_refund"
            ):
                move.secef_psvb_group = False

    @api.depends(
        "amount_total",
        "move_type",
        "secef_psvb_group",
    )
    def _compute_secef_psvb(
        self,
    ):
        rates = {
            "A": Decimal("2"),
            "B": Decimal("1"),
            "C": Decimal("0.2"),
            "D": Decimal("0"),
        }

        for move in self:
            group = (
                move.secef_psvb_group
                if (
                    move.move_type
                    == "out_invoice"
                )
                else False
            )

            rate = (
                rates.get(
                    group,
                    Decimal("0"),
                )
                if group
                else Decimal("0")
            )

            total_ttc = Decimal(
                str(
                    move.amount_total
                    or 0
                )
            )

            psvb_amount = (
                total_ttc
                * rate
                / Decimal("100")
            ).quantize(
                Decimal("0.01"),
                rounding=ROUND_HALF_UP,
            )

            total_with_psvb = (
                total_ttc
                + psvb_amount
            ).quantize(
                Decimal("0.01"),
                rounding=ROUND_HALF_UP,
            )

            move.secef_psvb_rate = float(
                rate
            )

            move.secef_psvb_amount = float(
                psvb_amount
            )

            move.secef_total_with_psvb = float(
                total_with_psvb
            )

            # Affichage fiscal exact à 2 décimales.
            # Ne passe pas par fields.Monetary / arrondi XOF.
            move.secef_psvb_amount_display = float(
                psvb_amount
            )

            move.secef_total_with_psvb_display = float(
                total_with_psvb
            )

    def _get_secef_comments_payload(self):
        self.ensure_one()

        comments = {}

        for field_id in "ABCDEFGH":
            field_name = (
                f"secef_comment_{field_id.lower()}"
            )

            content = (
                self[field_name] or ""
            ).strip()

            if content:
                comments[field_id] = content

        return comments

    def _get_secef_extra_info_payload(self):
        self.ensure_one()

        company = self.company_id

        extra_info = {}

        tax_regime = (
            company.secef_tax_regime or ""
        ).strip()

        if tax_regime:
            extra_info["REGIMP"] = tax_regime

        tax_office = (
            company.secef_tax_office or ""
        ).strip()

        if tax_office:
            extra_info["SERIMP"] = tax_office

        if self.partner_bank_id:
            bank_reference = (
                self.partner_bank_id.acc_number or ""
            ).strip()

            if bank_reference:
                extra_info["COMBAN"] = bank_reference

        return extra_info
