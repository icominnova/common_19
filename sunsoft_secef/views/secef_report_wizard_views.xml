<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record
        id="view_sunsoft_secef_report_wizard_form"
        model="ir.ui.view"
    >
        <field name="name">
            sunsoft.secef.report.wizard.form
        </field>

        <field name="model">sunsoft.secef.report.wizard</field>

        <field name="arch" type="xml">
            <form
                string="Generer un rapport X SECeF"
            >
                <group>
                    <field name="report_type"/>

                    <field
                        name="company_id"
                        options="{'no_create': True}"
                    />

                    <field
                        name="period_start"
                        invisible="
                            report_type !=
                            'x_periodic'
                        "
                        required="
                            report_type ==
                            'x_periodic'
                        "
                    />

                    <field name="period_end"/>
                </group>

                <footer>
                    <button
                        name="action_generate"
                        type="object"
                        string="Generer"
                        class="btn-primary"
                    />

                    <button
                        string="Annuler"
                        special="cancel"
                        class="btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>


    <record
        id="action_sunsoft_secef_report_wizard"
        model="ir.actions.act_window"
    >
        <field name="name">
            Generer un rapport X
        </field>

        <field name="res_model">sunsoft.secef.report.wizard</field>

        <field name="view_mode">form</field>

        <field name="target">new</field>
    </record>


    <menuitem
        id="menu_sunsoft_secef_generate_x"
        name="Generer un rapport X"
        parent="menu_sunsoft_secef_root"
        action="action_sunsoft_secef_report_wizard"
        sequence="5"
        groups="account.group_account_user,account.group_account_manager"
    />

    <record
        id="view_sunsoft_secef_z_report_wizard_form"
        model="ir.ui.view"
    >
        <field name="name">
            sunsoft.secef.z.report.wizard.form
        </field>

        <field name="model">sunsoft.secef.z.report.wizard</field>

        <field name="arch" type="xml">
            <form
                string="Generer un rapport Z SECeF"
            >
                <group>
                    <field
                        name="company_id"
                        options="{'no_create': True}"
                    />

                    <field
                        name="last_z_id"
                        readonly="1"
                    />

                    <field
                        name="period_end"
                    />
                </group>

                <div
                    class="alert alert-warning"
                    role="alert"
                >
                    Le rapport Z cloture la periode
                    ecoulee depuis le dernier rapport Z.
                    Cette cloture ne peut pas etre
                    modifiee ou supprimee.
                </div>

                <footer>
                    <button
                        name="action_generate"
                        type="object"
                        string="Generer et cloturer"
                        class="btn-primary"
                    />

                    <button
                        string="Annuler"
                        special="cancel"
                        class="btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>


    <record
        id="action_sunsoft_secef_z_report_wizard"
        model="ir.actions.act_window"
    >
        <field name="name">
            Generer un rapport Z
        </field>

        <field name="res_model">sunsoft.secef.z.report.wizard</field>

        <field name="view_mode">form</field>

        <field name="target">new</field>
    </record>


    <menuitem
        id="menu_sunsoft_secef_generate_z"
        name="Generer un rapport Z"
        parent="menu_sunsoft_secef_root"
        action="action_sunsoft_secef_z_report_wizard"
        sequence="6"
        groups="account.group_account_manager"
    />

    <record
        id="view_sunsoft_secef_a_report_wizard_form"
        model="ir.ui.view"
    >
        <field name="name">
            sunsoft.secef.a.report.wizard.form
        </field>

        <field name="model">sunsoft.secef.a.report.wizard</field>

        <field name="arch" type="xml">
            <form
                string="Generer un rapport A SECeF"
            >
                <group>
                    <field
                        name="company_id"
                        options="{'no_create': True}"
                    />

                    <field
                        name="last_a_id"
                        readonly="1"
                    />
                </group>

                <div
                    class="alert alert-warning"
                    role="alert"
                >
                    Le rapport A couvre les articles
                    depuis la generation du rapport A
                    precedent. La quantite en stock est
                    capturee au moment de cette generation
                    et devient immuable avec le rapport.
                </div>

                <footer>
                    <button
                        name="action_generate"
                        type="object"
                        string="Generer le rapport A"
                        class="btn-primary"
                    />

                    <button
                        string="Annuler"
                        special="cancel"
                        class="btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>


    <record
        id="action_sunsoft_secef_a_report_wizard"
        model="ir.actions.act_window"
    >
        <field name="name">
            Generer un rapport A
        </field>

        <field name="res_model">sunsoft.secef.a.report.wizard</field>

        <field name="view_mode">form</field>

        <field name="target">new</field>
    </record>


    <menuitem
        id="menu_sunsoft_secef_generate_a"
        name="Generer un rapport A"
        parent="menu_sunsoft_secef_root"
        action="action_sunsoft_secef_a_report_wizard"
        sequence="7"
        groups="account.group_account_manager"
    />

</odoo>
