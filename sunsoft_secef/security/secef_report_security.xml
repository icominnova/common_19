<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record
        id="sunsoft_secef_report_company_rule"
        model="ir.rule"
    >
        <field name="name">
            Rapports SECeF - societes autorisees
        </field>

        <field
            name="model_id"
            ref="model_sunsoft_secef_report"
        />

        <field name="domain_force">
            [('company_id', 'in', company_ids)]
        </field>

        <field
            name="groups"
            eval="[(4, ref('account.group_account_user'))]"
        />
    </record>


    <record
        id="sunsoft_secef_report_company_rule_manager"
        model="ir.rule"
    >
        <field name="name">
            Rapports SECeF - societes autorisees - administrateur
        </field>

        <field
            name="model_id"
            ref="model_sunsoft_secef_report"
        />

        <field name="domain_force">
            [('company_id', 'in', company_ids)]
        </field>

        <field
            name="groups"
            eval="[(4, ref('account.group_account_manager'))]"
        />
    </record>

</odoo>
