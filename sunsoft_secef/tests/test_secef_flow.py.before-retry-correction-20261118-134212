class FakeCentralClient:
    """Double de test du serveur central SECeF."""

    def __init__(
        self,
        *,
        create_response=None,
        get_response=None,
        create_error=None,
        get_error=None,
    ):
        self.create_response = create_response
        self.get_response = get_response

        self.create_error = create_error
        self.get_error = get_error

        self.create_calls = []
        self.get_calls = []

    def create_certification(
        self,
        *,
        request_uid,
        agent_uid,
        invoice_number,
        payload,
        job_type="invoice.certify",
    ):
        self.create_calls.append({
            "request_uid":
                request_uid,
            "agent_uid":
                agent_uid,
            "invoice_number":
                invoice_number,
            "payload":
                payload,
            "job_type":
                job_type,
        })

        if self.create_error:
            raise self.create_error

        if self.create_response is None:
            raise AssertionError(
                "Aucune réponse create configurée."
            )

        return self.create_response

    def get_certification(
        self,
        *,
        request_uid,
    ):
        self.get_calls.append({
            "request_uid":
                request_uid,
        })

        if self.get_error:
            raise self.get_error

        if self.get_response is None:
            raise AssertionError(
                "Aucune réponse GET configurée."
            )

        return self.get_response


