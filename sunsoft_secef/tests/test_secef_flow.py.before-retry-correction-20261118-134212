        )

        self.assertEqual(
            move._secef_expected_total_exact(),
            Decimal("2383.60"),
        )

        self.assertNotIn(
            "expected_total",
            payload["invoice"],
        )

    def test_01l_psvb_xof_fractional_total_regression(
        self,
    ):
        """
        Régression du cas réel :
        HT 1500
        TVA 18 % = 270
        TTC = 1770
        PSVB A 2 % = 35.40
        Total fiscal = 1805.40

        Le payload fiscal doit conserver les centimes même
        lorsque la devise XOF est configurée avec un arrondi
        monétaire à l'unité.
        """

        move = self._create_posted_invoice(
            quantity=1.0,
            price_unit=1500.0,
        )

        move.secef_psvb_group = "A"

        payload = (
            move._prepare_secef_payload()
        )

        self.assertAlmostEqual(
            move.amount_untaxed,
            1500.0,
            places=2,
        )

        self.assertAlmostEqual(
            move.amount_tax,
            270.0,
            places=2,
        )

        self.assertAlmostEqual(
            move.amount_total,
            1770.0,
            places=2,
        )

        self.assertEqual(
            move.secef_psvb_rate,
            2.0,
        )

        self.assertAlmostEqual(
            move.secef_psvb_amount_display,
            35.40,
            places=2,
        )

        self.assertAlmostEqual(
            move.secef_total_with_psvb_display,
            1805.40,
            places=2,
        )

        self.assertEqual(
            move._secef_expected_total_exact(),
            Decimal("1805.40"),
        )

        self.assertEqual(
            payload["invoice"]["psvb"],
            "A",
        )

        self.assertEqual(
            payload["expected_total"],
            "1805.40",
        )

