    def test_12_retry_after_failed_creates_new_outbox(
        self,
    ):
        move = (
            self._create_posted_invoice()
        )

        first_transaction = (
            self._create_outbox(
                move
            )
        )

        first_uid = (
            first_transaction
            .request_uid
        )

        first_transaction._mark_failed(
            "Échec certain de test."
        )

        self.assertEqual(
            move.secef_state,
            "failed",
        )

        move.action_request_secef_certification()

        transactions = (
            self.env[
                "sunsoft.secef.transaction"
            ]
            .search(
                [
                    (
                        "move_id",
                        "=",
                        move.id,
                    ),
                ],
                order="id asc",
            )
        )

        self.assertEqual(
            len(transactions),
            2,
        )

        new_transaction = (
            transactions
            .filtered(
                lambda transaction:
                    transaction.id
                    != first_transaction.id
            )
        )

        self.assertEqual(
            len(new_transaction),
            1,
        )

        self.assertEqual(
            first_transaction.state,
            "failed",
        )

        self.assertEqual(
            new_transaction.state,
            "pending",
        )

        self.assertNotEqual(
            first_uid,
            new_transaction.request_uid,
        )

        self.assertEqual(
            move.secef_state,
            "pending",
        )

        self.assertFalse(
            move.secef_error_message
        )

