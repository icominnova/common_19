    def _create_posted_invoice(
        self,
        quantity=2.0,
        price_unit=1000.0,
    ):
        move_form = Form(
            self.env[
                "account.move"
            ].with_context(
                default_move_type="out_invoice"
            )
        )

        move_form.partner_id = (
            self.partner
        )

        move_form.invoice_date = (
            fields.Date.today()
        )

        with (
            move_form
            .invoice_line_ids
            .new()
        ) as line:
            line.product_id = (
                self.product
            )

            line.quantity = quantity
            line.price_unit = price_unit

            line.tax_ids.clear()

            line.tax_ids.add(
                self.tax
            )

        move = move_form.save()

        move.action_post()

        return move

    def _create_posted_downpayment_invoice(
        self,
        percentage=30.0,
    ):
        order = self.env[
            "sale.order"
        ].create({
            "partner_id":
                self.partner.id,

            "order_line": [
                Command.create({
                    "product_id":
                        self.product.id,

                    "product_uom_qty":
                        2.0,

                    "price_unit":
                        1000.0,

                    "tax_ids":
                        [
                            Command.set(
                                self.tax.ids
                            )
                        ],
                }),
            ],
        })

        order.action_confirm()

        wizard = (
            self.env[
                "sale.advance.payment.inv"
            ]
            .with_context(
                active_model="sale.order",
                active_ids=order.ids,
            )
            .create({
                "advance_payment_method":
                    "percentage",

                "amount":
                    percentage,
            })
        )

        action = wizard.create_invoices()

        move = self.env[
            "account.move"
        ].browse(
            action["res_id"]
        )

        move.invoice_date = (
            fields.Date.today()
        )

        move.action_post()

        return move, order

    def _create_outbox(
        self,
        move,
    ):
        move.action_request_secef_certification()

        transaction = (
            move.secef_transaction_ids
            .sorted(
                key=lambda record:
                    record.id
            )[-1:]
        )

        self.assertTrue(
            transaction
        )

        return transaction

    def _central_response(
        self,
        move,
        transaction,
        *,
        status="pending",
        result=None,
        error_message=None,
        job_uid=None,
    ):
        return {
            "request_uid":
                transaction.request_uid,

            "job_uid":
                (
                    job_uid
                    or "JOB-%s"
                    % transaction.request_uid
                ),

            "agent_uid":
                transaction.agent_uid,

            "invoice_number":
                move.name,

            "status":
                status,

            "result":
                result,

            "error_message":
                error_message,
        }

