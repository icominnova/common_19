    def test_03_dispatch_records_central_job(
        self,
    ):
        move = (
            self._create_posted_invoice()
        )

        transaction = (
            self._create_outbox(
                move
            )
        )

        response = (
            self._central_response(
                move,
                transaction,
                status="pending",
            )
        )

        client = FakeCentralClient(
            create_response=response
        )

        result = (
            move
            ._dispatch_secef_transaction(
                transaction.sudo(),
                client=client,
            )
        )

        self.assertTrue(
            result
        )

        self.assertEqual(
            len(
                client.create_calls
            ),
            1,
        )

        call = (
            client
            .create_calls[0]
        )

        self.assertEqual(
            call[
                "request_uid"
            ],
            transaction.request_uid,
        )

        self.assertEqual(
            call[
                "agent_uid"
            ],
            self.agent_uid,
        )

        self.assertEqual(
            call[
                "invoice_number"
            ],
            move.name,
        )

        self.assertEqual(
            call[
                "job_type"
            ],
            "invoice.certify",
        )

        self.assertEqual(
            transaction.central_job_uid,
            response[
                "job_uid"
            ],
        )

        self.assertEqual(
            transaction.state,
            "pending",
        )

        self.assertFalse(
            move.secef_can_dispatch
