    def test_prepare_payload_final_invoice_after_downpayment_fv(
        self,
    ):
        downpayment_move, order = (
            self._create_posted_downpayment_invoice(
                percentage=30.0,
            )
        )

        self.assertTrue(
            downpayment_move._is_downpayment()
        )

        wizard = (
            self.env[
                "sale.advance.payment.inv"
            ]
            .with_context(
                active_model="sale.order",
                active_ids=order.ids,
            )
            .create({
                "advance_payment_method":
                    "delivered",

                "deduct_down_payments":
                    True,
            })
        )

        action = wizard.create_invoices()

        final_move = self.env[
            "account.move"
        ].browse(
            action["res_id"]
        )

        final_move.invoice_date = (
            fields.Date.today()
        )

        final_move.action_post()

        self.assertFalse(
            final_move._is_downpayment()
        )

        payload = (
            final_move._prepare_secef_payload()
        )

        self.assertEqual(
            payload[
                "invoice"
            ][
                "invoice_type"
            ],
            "FV",
        )

        self.assertTrue(
            payload["items"]
        )

        self.assertTrue(
            all(
                float(item["quantity"]) > 0
                for item in payload["items"]
            )
        )

        self.assertTrue(
            all(
                float(item["amount"]) > 0
                for item in payload["items"]
            )
        )

        self.assertFalse(
            any(
                item["is_downpayment"]
                for item in payload["items"]
            )
        )

        fiscal_total = sum(
            float(item["amount"])
            for item in payload["items"]
        )

        self.assertAlmostEqual(
            fiscal_total,
            final_move.amount_total,
            places=2,
        )

        self.assertEqual(
            len(payload["items"]),
            1,
        )

        item = payload["items"][0]

        self.assertAlmostEqual(
            float(item["quantity"]),
            2.0,
            places=2,
        )

        self.assertAlmostEqual(
            float(item["unit_price"]),
            700.0,
            places=2,
        )

        self.assertAlmostEqual(
            float(item["amount"]),
            1652.0,
            places=2,
        )

